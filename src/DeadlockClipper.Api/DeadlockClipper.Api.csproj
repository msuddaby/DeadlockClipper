<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\DeadlockClipper.Core\DeadlockClipper.Core.csproj" />
    <ProjectReference Include="..\DeadlockClipper.Render\DeadlockClipper.Render.csproj" />
    <ProjectReference Include="..\DeadlockClipper.GameData\DeadlockClipper.GameData.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.*" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Linux-only app (rendering needs gamescope/PipeWire); also stops ValveResourceFormat copying native libs for every platform. -->
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

</Project>
